# ---------------------------------------------------------------------------
# Database (PostgreSQL). With Supabase use the pooled URL for DATABASE_URL and
# the direct 5432 URL for DIRECT_URL so `prisma migrate` can take advisory locks.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/restaurant_crm?schema=public"
# Direct (non-pooled) connection used ONLY by `prisma migrate`. With a plain
# local Postgres, set it to the same value as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/restaurant_crm?schema=public"

# Separate database used by `npm test`. Tests TRUNCATE it between cases.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/restaurant_crm_test?schema=public"

# ---------------------------------------------------------------------------
# Session auth. Generate with: openssl rand -base64 48
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-me-with-a-64-char-random-string"
SESSION_TTL_HOURS="12"
# "true" only behind HTTPS. Leave false for local http://localhost development.
COOKIE_SECURE="false"

# ---------------------------------------------------------------------------
# Optional: delegate authentication to Supabase instead of local passwords.
# When AUTH_PROVIDER=supabase the CRM verifies Supabase JWTs and maps
# `sub` -> users.external_id. Leave as "local" to use built-in email/password.
# ---------------------------------------------------------------------------
AUTH_PROVIDER="local"
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_JWT_SECRET=""

# ---------------------------------------------------------------------------
# Outgoing webhooks (CRM -> n8n). Each delivery is signed:
#   X-CRM-Signature: sha256=<hex HMAC of "<timestamp>.<body>" using the
#                    per-endpoint secret stored in webhook_endpoints.secret>
#   X-CRM-Timestamp: <unix seconds>
# These two values seed the endpoint created by the seed script.
# ---------------------------------------------------------------------------
N8N_WEBHOOK_URL="http://localhost:5678/webhook/crm-events"
N8N_WEBHOOK_SECRET="replace-me-with-a-shared-secret"
# Max delivery attempts before an event is marked DEAD.
EVENT_MAX_ATTEMPTS="8"
EVENT_DISPATCH_BATCH_SIZE="25"

# ---------------------------------------------------------------------------
# Inbound API key for n8n (Authorization: Bearer <key>). The seed script prints
# a working key; this value lets you pin a known one for local development.
# ---------------------------------------------------------------------------
SEED_API_KEY="rk_test_local_development_key_change_me"

# Seed admin login.
SEED_ADMIN_EMAIL="admin@spicegarden.test"
SEED_ADMIN_PASSWORD="Password123!"

# ---------------------------------------------------------------------------
# Rate limiting (per API key / IP, sliding window, in-process).
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS="60"
RATE_LIMIT_MAX_REQUESTS="120"

# Default country code used to normalise local-format phone numbers to E.164.
DEFAULT_COUNTRY_CODE="91"

# ---------------------------------------------------------------------------
# Vercel Cron (optional). Vercel sends `Authorization: Bearer $CRON_SECRET` to
# scheduled paths, and the CRM's API-key auth accepts exactly that header — so
# set CRON_SECRET to a valid CRM API key and the nightly purge authenticates
# with no special casing.
# ---------------------------------------------------------------------------
CRON_SECRET=""
